# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — files/folders excluded from the Docker build context
# A smaller context = faster builds and smaller images.
# ─────────────────────────────────────────────────────────────────────────────

# Node modules — rebuilt inside the image
node_modules
npm-debug.log*

# Next.js build output — rebuilt inside the image
.next
out

# Environment files — never bake secrets into the image
.env
.env.*
!.env.example

# Version control
.git
.gitignore
.github

# Editor / OS artefacts
.DS_Store
*.pem
.vscode
.idea

# Test / coverage output
coverage
__tests__

# Docker files themselves (no need to copy them into the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation artefacts
*.md
DOCKER_MANUAL.md

# TypeScript build info (regenerated)
*.tsbuildinfo

# Vercel deploy artefacts
.vercel
